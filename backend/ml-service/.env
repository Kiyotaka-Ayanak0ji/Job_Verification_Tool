PORT=8001
MODELS_DIR=models
SEED_PATH=model/data/jd_seed.jsonl
FEEDBACK_LOG=models/feedback.jsonl
# Shared secret; leave unset for local dev
ML_SERVICE_API_KEY=
FIRECRAWL_API_KEY=fc-2cf34b8038af43e0bc91204d24145f0e

# Reddit API credentials for automated reputation data collection
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=TrustHire-Verification-Bot/1.0

# Glassdoor API key (optional - enhances Glassdoor data access if available)
GLASSDOOR_API_KEY=your_glassdoor_api_key_here

# Automated retraining configuration
# Set to "label_count" to trigger retraining when AUTO_RETRAIN_THRESHOLD labels are collected
# Set to "immediate" to trigger retraining after every CSV upload (not recommended for production)
RETRAIN_TRIGGER_MODE=label_count
AUTO_RETRAIN_THRESHOLD=100