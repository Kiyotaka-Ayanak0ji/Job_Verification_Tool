PORT=8000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/trusthire
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=trusthire

FLASK_URL=http://localhost:8001
ML_SERVICE_API_KEY=

FIRECRAWL_API_KEY=

CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:4173

VERIFY_CACHE_TTL_SECONDS=21600
VERIFY_LOCK_TTL_SECONDS=30

FREE_VERIFY_QUOTA=10
FREE_DEEP_QUOTA=1
FREE_PDF_QUOTA=2
PRO_VERIFY_QUOTA=50
PRO_DEEP_QUOTA=10
PRO_PDF_QUOTA=10

ADMIN_BOOTSTRAP_EMAIL=admin@trusthire.dev
ADMIN_BOOTSTRAP_PASSWORD=changeme-admin

# ---- Google OAuth (optional) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Razorpay (optional) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# Where users are sent after checkout success / cancel. Both usually point at
# the frontend Profile page; the checkout success handler auto-refreshes plan.
BILLING_SUCCESS_URL=http://localhost:5173/profile
BILLING_CANCEL_URL=http://localhost:5173/pricing

# ---- Retrain cron ----------------------------------------------------------
RETRAIN_CRON=0 3 * * *
RETRAIN_MIN_FEEDBACK=25
DISABLE_CRON=0